# Copy to .env and fill in. .env is never committed; the gate blocks it.
# One line per key the project needs, with where to get it. `./hack env` makes .env from this
# file; a key whose line follows the comment "./hack env: generate" gets a random value.

# Solana (devnet only)
SOLANA_RPC_URL=                 # devnet RPC endpoint
THETIS_PROGRAM_ID=              # from `anchor deploy`; never invented

# Supabase (project settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only (API, worker)

# AWS (API, fee sponsor, worker): local CLI profile; CI uses GitHub OIDC, no keys
AWS_PROFILE=
AWS_REGION=
SPONSOR_SECRET_ARN=             # Secrets Manager ARN of the fee sponsor key; the key itself never goes here

# Integrations
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
FIRECRAWL_API_KEY=
