{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": ["Txt", "Note", "ErrorBlock"]
          }
        }
      }
    }
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.expo", "!**/dist"]
  }
}
