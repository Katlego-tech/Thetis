{
  "expo": {
    "name": "Thetis field",
    "slug": "thetis-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "platforms": ["android"],
    "android": {
      "package": "dev.thetis.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2023"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Thetis field uses the camera to photograph weighbridge tickets, assay certificates and origin documents for an intake.",
          "photosPermission": false,
          "microphonePermission": "Thetis field uses the microphone only while you talk to the Thetis navigator."
        }
      ],
      ["expo-document-picker"],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/release-signing.js"
    ]
  }
}
