    "@types/aws-lambda": "8.10.164",
    "litesvm": "1.6.1"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1178.0",
    "@elevenlabs/elevenlabs-js": "2.76.0",
    "@solana-program/address-lookup-table": "0.16.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.6.0",
    "@supabase/supabase-js": "2.119.0",
    "@thetis/contracts": "workspace:*",
    "@thetis/sponsor": "workspace:*"
  }
