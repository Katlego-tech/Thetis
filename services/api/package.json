{
  "name": "@thetis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
